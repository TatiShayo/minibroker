# ==============================================================================
# MINIBROKER CONFIGURATION (.env.example)
# ==============================================================================

# Data Storage Directory
MINIBROKER_DATA_DIR=./data

# Log Segment Size Limit (Bytes) - default: 1MB (1048576)
MINIBROKER_SEGMENT_MAX_SIZE=1048576

# Sparse Offset Index Interval (messages between index points)
MINIBROKER_INDEX_INTERVAL=1000

# Retention Policy
# Maximum age of inactive segment files before cleanup (hours)
MINIBROKER_RETENTION_HOURS=72.0
# Maximum size in bytes per partition before oldest segments are deleted
MINIBROKER_RETENTION_MAX_BYTES=1073741824

# Default Partitions for New Topics
MINIBROKER_DEFAULT_PARTITIONS=1

# Dead Letter Queue (DLQ) Configuration
MINIBROKER_DLQ_MAX_RETRIES=3
MINIBROKER_DLQ_TOPIC_SUFFIX=.DLQ

# Consumer Group Rebalancing
MINIBROKER_CONSUMER_HEARTBEAT_TIMEOUT=30.0
# Rebalancing Strategy: "range", "round_robin", or "sticky"
MINIBROKER_REBALANCE_STRATEGY=range

# I/O Durability (true = fsync on write, false = OS buffered async flush)
MINIBROKER_SYNC_WRITES=false

# HTTP / WebSocket Server Binding
MINIBROKER_HOST=0.0.0.0
MINIBROKER_PORT=8000
